# Copiez ce fichier vers .env puis renseignez vos vraies valeurs (Supabase > Project Settings > API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Paiement manuel : numéros affichés au client sur la page de suivi (format 77XXXXXXX, sans espaces)
VITE_WAVE_NUMBER=
VITE_ORANGE_NUMBER=
# Numéro WhatsApp du support, avec indicatif et sans « + » (ex. 221771234567)
VITE_WHATSAPP_NUMBER=
